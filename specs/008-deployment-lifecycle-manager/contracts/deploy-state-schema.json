{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeployState",
  "type": "object",
  "required": [
    "schema_version",
    "container_name",
    "active_release",
    "active_venv_hash",
    "host_port",
    "installed_at",
    "last_updated_at",
    "history"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [2]
    },
    "container_name": {
      "type": "string"
    },
    "active_release": {
      "type": "string"
    },
    "previous_healthy_release": {
      "type": ["string", "null"]
    },
    "active_venv_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "ollama_target": {
      "type": "string"
    },
    "installed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["release_id", "deployed_at", "requirements_hash", "status"],
        "properties": {
          "release_id": {
            "type": "string"
          },
          "deployed_at": {
            "type": "string",
            "format": "date-time"
          },
          "requirements_hash": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["healthy", "failed", "rolled_back"]
          }
        }
      }
    }
  }
}
